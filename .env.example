# Copy to .env and adjust as needed. All values are optional.

# Where per-scan working directories are created.
SAST_WORKSPACE=/tmp/sast-studio-workspaces

# Per-tool wall-clock timeout in seconds.
SAST_TOOL_TIMEOUT=900
SAST_GIT_TIMEOUT=300

# How many tools run in parallel per scan.
SAST_MAX_WORKERS=4

# Upload / extraction safety limits.
SAST_MAX_UPLOAD_BYTES=209715200          # 200 MB
SAST_MAX_UNCOMPRESSED_BYTES=2147483648   # 2 GB
SAST_MAX_FILES=200000

# Allow scanning arbitrary server-local paths (operator-only capability).
SAST_ALLOW_LOCAL_PATH=true

# Comma-separated git url schemes permitted for clone.
SAST_GIT_SCHEMES=http,https

# The address this deployment is reached at, e.g. https://sast.example.com
# The MCP client config and the .env template tell a tool where to send its
# bearer token. Leaving that to be derived from the Host header lets whoever
# sets that header choose the destination, so set this on a real deployment.
SAST_PUBLIC_URL=
# Fallback when SAST_PUBLIC_URL is unset: host names this deployment answers
# to, comma separated. A Host outside this list is never echoed back.
SAST_ALLOWED_HOSTS=

# Semgrep ruleset; needs network. Use a local path for offline scanning.
# Not "auto": it is rejected because scans always run with --metrics=off.
SAST_SEMGREP_RULES=p/default
